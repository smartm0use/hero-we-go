<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#65CAFF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101419</item>
        <item name="android:navigationBarColor">#101419</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#101419</item>
    </style>
    <style name="PlayerDialogTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#65CAFF</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
